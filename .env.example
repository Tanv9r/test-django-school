# Copy this file to .env and adjust. Never commit .env.

# Development mode. Set to False in production.
DJANGO_DEBUG=True

# Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=change-me

# Comma-separated host names this site may be served from.
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Required behind HTTPS in production, e.g. https://hms.example.org
DJANGO_CSRF_TRUSTED_ORIGINS=

# Secure cookies default to True when DEBUG is False.
# DJANGO_SECURE_COOKIES=True
# DJANGO_SECURE_SSL_REDIRECT=False
# DJANGO_HSTS_SECONDS=0

# Local time zone used for scheduling and display (IANA name).
HMS_TIME_ZONE=UTC

# SQLite database file. Use a separate file for demo data, e.g. demo.sqlite3
# HMS_DB_PATH=db.sqlite3
